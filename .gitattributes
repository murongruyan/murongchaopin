*.sh text eol=lf
*.mjs text eol=lf
*.java text eol=lf

# Windows checkouts must not rewrite the text configuration the module parses on
# the device. core.autocrlf turned config/display_mode_manifest.txt into CRLF
# once, and mode_manifest_resolution() rejects the resulting value because a
# trailing CR is not in [0-9:] - which fails mode_manifest_validate() and takes
# the whole installer down with it. Keep these LF everywhere.
*.sh            text eol=lf
*.txt           text eol=lf
*.json          text eol=lf
*.awk           text eol=lf
# Executables without a .sh extension are launched through their shebang, so a
# CRLF checkout makes the kernel look for an interpreter literally named "sh\r".
# That is how the release job died with "/usr/bin/env: 'sh\r': No such file or
# directory" on src/settings_hook/gradlew.  Update-binary runs from the installer
# on the device, where the same rule applies.
gradlew              text eol=lf
update-binary        text eol=lf
gradlew.bat          text eol=crlf
